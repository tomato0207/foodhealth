# Copy this file to .env and fill in real values. See README.md for where to get each one.

# Transaction pooler (port 6543) — required for Vercel/serverless (no IPv6 egress there)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Direct connection — only used manually for `prisma migrate`, not read by the app
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

AI_PROVIDER="gemini"   # or "lmstudio"

LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_MODEL="qwen2-vl-7b-instruct"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

SESSION_COOKIE_NAME="session_token"

ALLOW_REGISTRATION="true"   # set to "false" on public deployments
